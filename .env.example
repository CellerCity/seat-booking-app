# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database ---------------------------------------------------------------
# Supabase dashboard → "Connect" button in the top bar. Copy the strings as
# shown; the pooler host and username differ from the direct one and cannot be
# derived from it. Replace [YOUR-PASSWORD] with the database password (set at
# project creation, resettable under Settings → Database), URL-encoding any
# @ : / # characters in it.
#
# App traffic → Transaction pooler (port 6543). Serverless functions open a
# connection per invocation; the pooler is what stops that exhausting Postgres.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Migrations → Direct connection (port 5432). DDL needs session-level statements
# the transaction pooler does not support.
# NOTE: the direct host is IPv6-only on free projects. If `npm run db:migrate`
# fails with ENETUNREACH or a DNS error, your network has no IPv6 — use the
# Session pooler string (same pooler host, port 5432) here instead. It works.
DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# --- Supabase auth (coordinator magic links) --------------------------------
# Settings → API Keys. Newer projects show sb_publishable_… / sb_secret_… keys
# instead of the older eyJ… JWTs; either format drops into these variables.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# SERVICE ROLE KEY (or sb_secret_…) — full database access, bypasses RLS.
# Server-side only. It must never appear in a NEXT_PUBLIC_ variable or a client bundle.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Traveller session cookie ------------------------------------------------
# Signs the identity cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET="at-least-32-characters-of-random-text-here"

# --- Cron ---------------------------------------------------------------------
# Shared secret so only Vercel Cron can hit /api/cron/*. Generate the same way.
CRON_SECRET="another-long-random-string"

# --- Trip defaults ------------------------------------------------------------
# Used by the weekly auto-create cron. IST is assumed for display; stored UTC.
TRIP_DESTINATION="Event venue"
TRIP_DAY_OF_WEEK="6"          # 0=Sunday … 6=Saturday
TRIP_DEPARTURE_TIME="07:30"
POLL_OPENS_DAYS_BEFORE="2"
POLL_CLOSES_TIME="20:00"      # advisory only — never disables booking

# --- Payment ------------------------------------------------------------------
# UPI VPA that dues are collected into, and the name shown in the payment app.
UPI_VPA="coordinator@bank"
UPI_PAYEE_NAME="Trip Coordinators"
